name: Build and release binaries
on:
  workflow_dispatch:
    inputs:
      runner:
        required: false
        description: 'Runner image name'
        default: 'windows-2022'
      do-release:
        required: false
        type: boolean
        description: 'Create a release after build is done'
        default: false

permissions:
  contents: read

env:
  WINSPARKLE_ED_KEY: {% raw %}${{ vars.WINSPARKLE_ED_KEY }}{% endraw %}
  WINSPARKLE_APPCAST_URL: {% raw %}${{ vars.WINSPARKLE_APPCAST_URL }}{% endraw %}
  WINSPARKLE_AUTHENTICODE_ORG: {% raw %}${{ vars.WINSPARKLE_AUTHENTICODE_ORG }}{% endraw %}

jobs:
{%- for arch in ["", "arm"] %}
{%- set prefix = "build"    ~ ('-arm' if arch == 'arm' else '') %}
{%- for n in range(15) %}
  {{ prefix }}-{{ n + 1 }}:
{%- if n %}
    needs: {{ prefix }}-{{ n }}
    if: needs.{{ prefix }}-{{ n }}.outputs.finished == 'false'
{%- endif %}
    runs-on: {% raw %}${{ github.event.inputs.runner }}{% endraw %}
    steps:
      - name: Checkout
        uses: actions/checkout@v3
        with:
          submodules: 'recursive'
      - name: Set up Python 3.12
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Init
        run: Copy-Item -Path . -Destination "C:\focus-windows" -Recurse
      - name: Setup Stage
        run: npm install
        working-directory: ./.github/actions/stage
      - name: Run Stage
        id: stage
        uses: ./.github/actions/stage
        with:
          from_artifact: {{ "true" if n else "false" }}
          {%- if arch == "arm" %}
          arm: true
          {%- endif %}
    outputs:
      finished: {% raw %}${{ steps.stage.outputs.finished }}{% endraw %}
{%- endfor %}
  {{ prefix }}-final:
    needs: {{ prefix }}-15
{%- raw %}
    if: ${{ !cancelled() && !failure() }}
    runs-on: ${{ github.event.inputs.runner }}
    env:
      AZURE_SIGNING_ENABLED: ${{ vars.ENABLE_AZURE_SIGNING }}
      AZURE_SIGNING_CONFIGURED: ${{ secrets.AZURE_TENANT_ID != '' && secrets.AZURE_CLIENT_ID != '' && secrets.AZURE_CLIENT_SECRET != '' && secrets.AZURE_SIGNING_ENDPOINT != '' && secrets.AZURE_SIGNING_ACCOUNT != '' && secrets.AZURE_SIGNING_CERTIFICATE_NAME != '' }}
    steps:
      - name: Checkout
        uses: actions/checkout@v3
        with:
          submodules: 'recursive'
      - name: Set up Python 3.12
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Init
        run: Copy-Item -Path . -Destination "C:\focus-windows" -Recurse
      - name: Setup Stage
        run: npm install
        working-directory: ./.github/actions/stage
      - name: Run Stage
        id: stage
        uses: ./.github/actions/stage
        with:
          {% endraw -%}{%- if arch == "arm" -%}
          arm: true
          {% endif %}{%- raw -%}
          from_artifact: true

      - name: Sign Focus binaries
        if: ${{ env.AZURE_SIGNING_ENABLED == 'true' && env.AZURE_SIGNING_CONFIGURED == 'true' }}
        uses: azure/artifact-signing-action@v1
        with:
          azure-tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          azure-client-id: ${{ secrets.AZURE_CLIENT_ID }}
          azure-client-secret: ${{ secrets.AZURE_CLIENT_SECRET }}
          endpoint: ${{ secrets.AZURE_SIGNING_ENDPOINT }}
          signing-account-name: ${{ secrets.AZURE_SIGNING_ACCOUNT }}
          certificate-profile-name: ${{ secrets.AZURE_SIGNING_CERTIFICATE_NAME }}
          files: ${{ steps.stage.outputs.files-to-sign }}
          description: Focus Browser
          description-url: https://github.com/${{ github.repository }}

      # we want a different description here, so sign it separately again
      - name: Sign Focus update helper
        if: ${{ env.AZURE_SIGNING_ENABLED == 'true' && env.AZURE_SIGNING_CONFIGURED == 'true' }}
        uses: azure/artifact-signing-action@v1
        with:
          azure-tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          azure-client-id: ${{ secrets.AZURE_CLIENT_ID }}
          azure-client-secret: ${{ secrets.AZURE_CLIENT_SECRET }}
          endpoint: ${{ secrets.AZURE_SIGNING_ENDPOINT }}
          signing-account-name: ${{ secrets.AZURE_SIGNING_ACCOUNT }}
          certificate-profile-name: ${{ secrets.AZURE_SIGNING_CERTIFICATE_NAME }}
          files: C:\focus-windows\build\src\out\Default\focus_update_helper.exe
          description: Focus Browser Update Helper
          description-url: https://github.com/${{ github.repository }}

      - name: Build Focus installer and package
        id: stage2
        uses: ./.github/actions/stage
        with:
          {% endraw -%}{%- if arch == "arm" -%}
          arm: true
          {% endif %}{%- raw -%}
          gen_installer: true
          from_artifact: false

      - name: Sign Focus installer
        if: ${{ env.AZURE_SIGNING_ENABLED == 'true' && env.AZURE_SIGNING_CONFIGURED == 'true' }}
        uses: azure/artifact-signing-action@v1
        with:
          azure-tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          azure-client-id: ${{ secrets.AZURE_CLIENT_ID }}
          azure-client-secret: ${{ secrets.AZURE_CLIENT_SECRET }}
          endpoint: ${{ secrets.AZURE_SIGNING_ENDPOINT }}
          signing-account-name: ${{ secrets.AZURE_SIGNING_ACCOUNT }}
          certificate-profile-name: ${{ secrets.AZURE_SIGNING_CERTIFICATE_NAME }}
          files: C:\focus-windows\build\FocusBrowser_*-installer.exe
          description: Focus Browser Installer
          description-url: https://github.com/${{ github.repository }}

      - name: Upload artifacts
        id: stage3
        uses: ./.github/actions/stage
        with:
          {% endraw -%}{%- if arch == "arm" -%}
          arm: true
          {% endif %}{%- raw -%}
          upload_final: true
          from_artifact: false

    outputs:
      finished: ${{ steps.stage3.outputs.finished }}
      version: ${{ steps.stage3.outputs.version }}
      display_version: ${{ steps.stage3.outputs.display_version }}
      release_tag: ${{ steps.stage3.outputs.release_tag }}
{% endraw -%}
{% endfor -%}
{% raw %}
  publish-release:
    permissions:
      contents: write
    needs: [build-final, build-arm-final]
    if: ${{ inputs.do-release && !cancelled() && !failure()
            && needs.build-final.result == 'success'
            && needs.build-arm-final.result == 'success' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: true
          fetch-depth: 0
          fetch-tags: true
      - name: Download package
        uses: actions/download-artifact@v4
        with:
          name: focus-x86_64
      - name: Download arm package
        uses: actions/download-artifact@v4
        with:
          name: focus-arm64
      - name: Create release notes
        shell: bash
        run: |
          GH_RUN_HREF="https://github.com/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}"
          LAST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || true)
          {
            printf 'Changes since last build:\n### Focus Browser\n```\n'
            if [ -n "$LAST_TAG" ]; then
              git log --oneline "$LAST_TAG..HEAD"
            else
              git log --oneline -n 100
            fi
            printf '```\n\n---\n\n'
            printf 'See [this GitHub Actions Run](%s) for the [Workflow file](%s/workflow) used '
            printf 'as well as the build logs and artifacts\n' "$GH_RUN_HREF" "$GH_RUN_HREF"
          } | tee ./github_release_note.md
      - name: Publish release
        id: publish
        uses: imputnet/action-gh-release@v2.5
        with:
          fail_on_unmatched_files: true
          body_path: ./github_release_note.md
          prerelease: false
          name: Focus Browser ${{ needs.build-final.outputs.display_version }}
          tag_name: ${{ needs.build-final.outputs.release_tag }}
          files: |
            FocusBrowser_*
    outputs:
      assets: ${{ steps.publish.outputs.assets }}
{% endraw -%}
