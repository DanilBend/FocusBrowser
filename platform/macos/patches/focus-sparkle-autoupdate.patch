+void SetUpSystemUpdater() {}
+
+void CheckForUpdate(UpdateCallback callback) {
+  scoped_refptr<base::SequencedTaskRunner> origin_task_runner =
+      base::SequencedTaskRunner::GetCurrentDefault();
+  PostToMainSequence(base::BindOnce(
+      [](scoped_refptr<base::SequencedTaskRunner> task_runner,
+         UpdateCallback update_callback) {
+        EnsureUpdaterStartedAfterLaunchOnMainSequence(base::BindOnce(
+            &BeginManualUpdateCheckOnMainSequence, std::move(task_runner),
+            std::move(update_callback)));
+      },
+      std::move(origin_task_runner), std::move(callback)));
+}
+
+void SchedulePeriodicTasks(base::RepeatingClosure /*prompt*/) {
+  PostToMainSequence(base::BindOnce(
+      &EnsureUpdaterStartedAfterLaunchOnMainSequence, StartCompletion()));
+}
