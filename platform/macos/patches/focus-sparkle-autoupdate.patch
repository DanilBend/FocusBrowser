+  if not isinstance(version, str):
+    return False
+  version_parts = version.split('.')
+  if (len(version_parts) != 4 or version_parts[-1] != '0' or
+      any(not part.isdecimal() or part != str(int(part))
+          for part in version_parts)):
+    return False
+  plist['CFBundleShortVersionString'] = '.'.join(version_parts[:3])
+  plist.update({
