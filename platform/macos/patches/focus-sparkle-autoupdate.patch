+base::Version CurrentlyInstalledVersion() {
+  // Read the outer bundle on every poll: Sparkle may already have replaced it
+  // while this older process is still running. The four-component
+  // CFBundleVersion is the same namespace used by sparkle:version.
+  base::ScopedBlockingCall blocks(FROM_HERE, base::BlockingType::WILL_BLOCK);
+  const base::FilePath plist_path = base::apple::OuterBundlePath()
+                                        .Append("Contents")
+                                        .Append("Info.plist");
+  NSDictionary* info_plist = [NSDictionary
+      dictionaryWithContentsOfFile:base::apple::FilePathToNSString(plist_path)];
+  NSString* version =
+      base::apple::ObjCCast<NSString>(info_plist[@"CFBundleVersion"]);
+  return version == nil
+             ? base::Version()
+             : base::Version(base::SysNSStringToUTF8(version));
+}
+
+void EnsureUpdater(base::TaskPriority /*priority*/,
+                   base::OnceClosure /*prompt*/,
+                   base::OnceClosure complete) {
+  scoped_refptr<base::SequencedTaskRunner> origin_task_runner =
+      base::SequencedTaskRunner::GetCurrentDefault();
+  PostToMainSequence(base::BindOnce(
+      [](scoped_refptr<base::SequencedTaskRunner> reply_task_runner,
+         base::OnceClosure completion) {
+        EnsureUpdaterStartedAfterLaunchOnMainSequence(base::BindOnce(
+            [](scoped_refptr<base::SequencedTaskRunner> task_runner,
+               base::OnceClosure reply, int /*error_code*/) {
+              task_runner->PostTask(FROM_HERE, std::move(reply));
+            },
+            std::move(reply_task_runner), std::move(completion)));
+      },
+      std::move(origin_task_runner), std::move(complete)));
+}
