+
+#include "chrome/browser/updater/updater.h"
+
+#import <AppKit/AppKit.h>
+#import <Sparkle/Sparkle.h>
+
+#include <memory>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/apple/bundle_locations.h"
+#include "base/apple/foundation_util.h"
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/task/task_traits.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "base/version.h"
+#include "chrome/updater/mojom/updater_service.mojom.h"
+
+namespace {
+
+using UpdateCallback =
+    base::RepeatingCallback<void(const updater::mojom::UpdateState&)>;
+
+struct ManualUpdateRequest {
+  scoped_refptr<base::SequencedTaskRunner> origin_task_runner;
+  UpdateCallback callback;
+};
+
+std::unique_ptr<ManualUpdateRequest>& CurrentManualUpdateRequest() {
+  static base::NoDestructor<std::unique_ptr<ManualUpdateRequest>> request;
+  return *request;
+}
+
+void RunUpdateCallback(UpdateCallback callback,
+                       updater::mojom::UpdateState::State state,
+                       int error_code,
+                       int extra_code) {
+  updater::mojom::UpdateState update_state;
+  update_state.state = state;
+  update_state.error_code = error_code;
+  update_state.extra_code1 = extra_code;
+  callback.Run(update_state);
+}
+
+void ReportManualState(updater::mojom::UpdateState::State state,
+                       int error_code = 0,
+                       int extra_code = 0) {
+  if (!CurrentManualUpdateRequest()) {
+    return;
+  }
+  CurrentManualUpdateRequest()->origin_task_runner->PostTask(
+      FROM_HERE,
+      base::BindOnce(&RunUpdateCallback, CurrentManualUpdateRequest()->callback,
+                     state, error_code, extra_code));
+}
+
+void FinishManualUpdateRequest(updater::mojom::UpdateState::State state,
+                               int error_code = 0,
+                               int extra_code = 0) {
+  ReportManualState(state, error_code, extra_code);
+  CurrentManualUpdateRequest().reset();
+}
+
+bool IsNoUpdateError(NSError* error) {
+  return error != nil &&
+         [error.domain isEqualToString:SUSparkleErrorDomain] &&
+         error.code == SUNoUpdateError;
+}
+
+bool IsAuthorizationDeferredError(NSError* error) {
+  return error != nil &&
+         [error.domain isEqualToString:SUSparkleErrorDomain] &&
+         (error.code == SUInstallationAuthorizeLaterError ||
+          error.code == SUInstallationCanceledError);
+}
+
+}  // namespace
+
+@interface FocusSparkleUpdaterDelegate : NSObject <SPUUpdaterDelegate>
+@end
+
+@implementation FocusSparkleUpdaterDelegate
+
+- (void)updater:(SPUUpdater*)updater
+    didFindValidUpdate:(SUAppcastItem*)item {
+  ReportManualState(updater::mojom::UpdateState::State::kUpdateAvailable);
+}
+
+- (void)updater:(SPUUpdater*)updater
+    willDownloadUpdate:(SUAppcastItem*)item
+            withRequest:(NSMutableURLRequest*)request {
+  ReportManualState(updater::mojom::UpdateState::State::kDownloading);
+}
+
+- (void)updater:(SPUUpdater*)updater
+    didDownloadUpdate:(SUAppcastItem*)item {
+  ReportManualState(updater::mojom::UpdateState::State::kDecompressing);
+}
+
+- (void)updater:(SPUUpdater*)updater
+    willExtractUpdate:(SUAppcastItem*)item {
+  ReportManualState(updater::mojom::UpdateState::State::kDecompressing);
+}
+
+- (void)updater:(SPUUpdater*)updater
+    didExtractUpdate:(SUAppcastItem*)item {
+  ReportManualState(updater::mojom::UpdateState::State::kPatching);
+}
+
+- (void)updater:(SPUUpdater*)updater
+    willInstallUpdate:(SUAppcastItem*)item {
+  ReportManualState(updater::mojom::UpdateState::State::kInstalling);
+}
+
+- (BOOL)updater:(SPUUpdater*)updater
+    willInstallUpdateOnQuit:(SUAppcastItem*)item
+    immediateInstallationBlock:(void (^)(void))immediateInstallHandler {
+  FinishManualUpdateRequest(
+      updater::mojom::UpdateState::State::kUpdated);
+  return NO;
+}
+
+- (void)updater:(SPUUpdater*)updater
+    didFinishUpdateCycleForUpdateCheck:(SPUUpdateCheck)updateCheck
+                                 error:(NSError*)error {
+  if (!CurrentManualUpdateRequest()) {
+    return;
+  }
+  // Sparkle may focus an update from a background cycle instead of starting a
+  // new manual cycle. Whichever cycle the manual request attached to must
+  // therefore deliver its terminal result.
+  if (IsNoUpdateError(error)) {
+    FinishManualUpdateRequest(
+        updater::mojom::UpdateState::State::kNoUpdate);
+  } else if (IsAuthorizationDeferredError(error)) {
+    FinishManualUpdateRequest(
+        updater::mojom::UpdateState::State::kUpdateError,
+        updater::kUpdateDeferredErrorCode, static_cast<int>(error.code));
+  } else if (error != nil) {
+    FinishManualUpdateRequest(
+        updater::mojom::UpdateState::State::kUpdateError,
+        static_cast<int>(error.code));
+  } else {
+    // A nil Sparkle error means the cycle ended normally. If no earlier
+    // terminal callback completed this request, the user dismissed/skipped the
+    // update or deferred installation; do not leave About stuck on "Checking".
+    FinishManualUpdateRequest(
+        updater::mojom::UpdateState::State::kUpdateError,
+        updater::kUpdateDeferredErrorCode);
+  }
+}
+
+@end
+
+namespace updater {
+namespace {
+
+FocusSparkleUpdaterDelegate* g_delegate = nil;
+SPUStandardUpdaterController* g_controller = nil;
+id g_launch_observer = nil;
+bool g_application_did_finish_launching = false;
+
+using StartCompletion = base::OnceCallback<void(int)>;
+
+std::vector<StartCompletion>& PendingStartCompletions() {
+  static base::NoDestructor<std::vector<StartCompletion>> completions;
+  return *completions;
+}
+
+void AssertOnMainSequence() {
+  DCHECK(base::SingleThreadTaskRunner::GetMainThreadDefault()
+             ->RunsTasksInCurrentSequence());
+}
+
+int StartUpdaterOnMainSequence() {
+  AssertOnMainSequence();
+  if (g_controller != nil) {
+    return 0;
+  }
+
+  FocusSparkleUpdaterDelegate* delegate =
+      [[FocusSparkleUpdaterDelegate alloc] init];
+  SPUStandardUpdaterController* controller =
+      [[SPUStandardUpdaterController alloc]
+      initWithStartingUpdater:NO
+              updaterDelegate:delegate
+           userDriverDelegate:nil];
+  NSError* error = nil;
+  if (controller == nil || ![controller.updater startUpdater:&error]) {
+    const int error_code =
+        error != nil ? static_cast<int>(error.code) : 0;
+    return error_code != 0 ? error_code
+                           : static_cast<int>(SUInvalidUpdaterError);
+  }
+
+  g_delegate = delegate;
+  g_controller = controller;
+  return 0;
+}
+
+void CompletePendingStartsOnMainSequence(int error_code) {
+  AssertOnMainSequence();
+  std::vector<StartCompletion> completions =
+      std::move(PendingStartCompletions());
+  PendingStartCompletions().clear();
+  for (StartCompletion& completion : completions) {
+    std::move(completion).Run(error_code);
+  }
+}
+
+void StartUpdaterAndCompletePendingRequestsOnMainSequence() {
+  AssertOnMainSequence();
+  CompletePendingStartsOnMainSequence(StartUpdaterOnMainSequence());
+}
+
+bool ApplicationDidFinishLaunching() {
+  return g_application_did_finish_launching ||
+         (NSApp != nil && NSApp.isRunning);
+}
+
+void EnsureUpdaterStartedAfterLaunchOnMainSequence(StartCompletion completion) {
+  AssertOnMainSequence();
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("headless")) {
+    if (!completion.is_null()) {
+      std::move(completion).Run(
+          static_cast<int>(SUIncorrectAPIUsageError));
+    }
+    return;
+  }
+  if (!completion.is_null()) {
+    PendingStartCompletions().push_back(std::move(completion));
+  }
+
+  if (ApplicationDidFinishLaunching()) {
+    StartUpdaterAndCompletePendingRequestsOnMainSequence();
+    return;
+  }
+  if (g_launch_observer != nil) {
+    return;
+  }
+
+  g_launch_observer = [[NSNotificationCenter defaultCenter]
+      addObserverForName:NSApplicationDidFinishLaunchingNotification
+                  object:nil
+                   queue:[NSOperationQueue mainQueue]
+              usingBlock:^(NSNotification* /*notification*/) {
+                g_application_did_finish_launching = true;
+                id observer = g_launch_observer;
+                g_launch_observer = nil;
+                if (observer != nil) {
+                  [[NSNotificationCenter defaultCenter]
+                      removeObserver:observer];
+                }
+                StartUpdaterAndCompletePendingRequestsOnMainSequence();
+              }];
+}
+
+void BeginManualUpdateCheckOnMainSequence(
+    scoped_refptr<base::SequencedTaskRunner> origin_task_runner,
+    UpdateCallback callback,
+    int start_error_code) {
+  AssertOnMainSequence();
+  ManualUpdateRequest request{std::move(origin_task_runner),
+                              std::move(callback)};
+  if (start_error_code != 0) {
+    request.origin_task_runner->PostTask(
+        FROM_HERE,
+        base::BindOnce(&RunUpdateCallback, request.callback,
+                       mojom::UpdateState::State::kUpdateError,
+                       start_error_code, 0));
+    return;
+  }
+  if (CurrentManualUpdateRequest() || g_controller == nil ||
+      !g_controller.updater.canCheckForUpdates) {
+    request.origin_task_runner->PostTask(
+        FROM_HERE,
+        base::BindOnce(&RunUpdateCallback, request.callback,
+                       mojom::UpdateState::State::kUpdateError,
+                       static_cast<int>(SUIncorrectAPIUsageError), 0));
+    return;
+  }
+
+  CurrentManualUpdateRequest() =
+      std::make_unique<ManualUpdateRequest>(std::move(request));
+  ReportManualState(mojom::UpdateState::State::kCheckingForUpdates);
+  [g_controller.updater checkForUpdates];
+}
+
+void PostToMainSequence(base::OnceClosure task) {
+  base::SingleThreadTaskRunner::GetMainThreadDefault()->PostTask(
+      FROM_HERE, std::move(task));
+}
