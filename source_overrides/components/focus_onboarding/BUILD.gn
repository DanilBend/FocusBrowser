  dist_dir = "$target_gen_dir/dist"

  args = [
    rebase_path("node_modules/vite/bin/vite.js"),
    "build",
    rebase_path("."),
    "--outDir",
    rebase_path(dist_dir),
    "--emptyOutDir",
  ]

  # Keep these explicit: Ninja does not recursively track directory inputs.
  # This prevents an edited logo/page from silently reusing an older bundle.
  inputs = [
    "index.html",
    "src",
    "public",
    "package.json",
    "pnpm-lock.yaml",
    "vite.config.ts",
    "svelte.config.js",
