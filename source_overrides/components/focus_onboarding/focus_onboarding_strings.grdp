<?xml version='1.0' encoding='utf-8'?>
<grit-part>

<message name="IDS_FOCUS_ONBOARDING_PAGE_TITLE" desc="The title of the Focus setup onboarding page.">
  Focus Browser Setup
</message>

<message name="IDS_FOCUS_ONBOARDING_SETUP_CAPTION" desc="Short caption below the Focus Browser name in the onboarding sidebar.">
  Initial setup
</message>
<message name="IDS_FOCUS_ONBOARDING_SETUP_STEPS_ARIA" desc="Accessible label for the onboarding step list.">
  Initial setup steps
</message>
<message name="IDS_FOCUS_ONBOARDING_SETUP_NOTE" desc="Sidebar note explaining that onboarding choices can be changed later.">
  You can change every option later in browser settings.
</message>
<message name="IDS_FOCUS_ONBOARDING_SETUP_STEP_FOCUS" desc="Short sidebar label for focus preferences.">
  Work preferences
</message>
<message name="IDS_FOCUS_ONBOARDING_SETUP_STEP_APPEARANCE" desc="Short sidebar label for address bar appearance.">
  Address bar
</message>
<message name="IDS_FOCUS_ONBOARDING_SETUP_STEP_SEARCH" desc="Short sidebar label for search selection.">
  Search
</message>
<message name="IDS_FOCUS_ONBOARDING_SETUP_STEP_IMPORT" desc="Short sidebar label for browser data import.">
  Data import
</message>
<message name="IDS_FOCUS_ONBOARDING_SETUP_STEP_PASSWORDS" desc="Short sidebar label for the built-in password manager.">
  Passwords
</message>
<message name="IDS_FOCUS_ONBOARDING_SETUP_STEP_DEFAULT" desc="Short sidebar label for the default browser choice.">
  Default browser
</message>
<message name="IDS_FOCUS_ONBOARDING_SETUP_STEP_SHORTCUTS" desc="Short sidebar label for New Tab Page shortcuts.">
  Shortcuts
</message>

<message name="IDS_FOCUS_ONBOARDING_BUTTON_USE_DEFAULTS" desc="Button label that skips detailed setup and applies the default onboarding choices.">
  Use focus preset
</message>
<message name="IDS_FOCUS_ONBOARDING_BUTTON_CONFIGURE" desc="Button label that starts the detailed onboarding setup flow.">
  Set up Focus Browser
</message>
<message name="IDS_FOCUS_ONBOARDING_BUTTON_NEXT" desc="Button label to continue to the next onboarding step.">
  Next
</message>
<message name="IDS_FOCUS_ONBOARDING_BUTTON_BACK" desc="Button label to return to the previous onboarding step.">
  Back
</message>
<message name="IDS_FOCUS_ONBOARDING_BUTTON_LETS_GO" desc="Button label that finishes onboarding and opens the browser.">
  Start working
</message>
<message name="IDS_FOCUS_ONBOARDING_BUTTON_SKIP" desc="Button label that skips optional shortcut selection.">
  Skip
</message>
<message name="IDS_FOCUS_ONBOARDING_BUTTON_START" desc="Button label that saves shortcut choices and finishes onboarding.">
  Start
</message>
<message name="IDS_FOCUS_ONBOARDING_NAVIGATION_ERROR" desc="Error shown when the current onboarding choices could not be saved.">
  Couldn't save your settings. Check your choices and try again.
</message>
<message name="IDS_FOCUS_ONBOARDING_NAVIGATION_STEP" desc="Label before the current onboarding step number.">
  Step
</message>
<message name="IDS_FOCUS_ONBOARDING_NAVIGATION_OF" desc="Separator between the current and total onboarding step counts.">
  of
</message>

<message name="IDS_FOCUS_ONBOARDING_PARTNER_TITLE" desc="Badge title shown for partner services in onboarding.">
  Focus Browser partner
</message>
<message name="IDS_FOCUS_ONBOARDING_PARTNER_TOOLTIP" desc="Tooltip explaining why a listed service is marked as a Focus partner.">
  Payment from this service helps support Focus Browser development.
</message>

<message name="IDS_FOCUS_ONBOARDING_WELCOME_GREETING" desc="Main greeting on the first onboarding screen.">
  Focus on what matters.
</message>
<message name="IDS_FOCUS_ONBOARDING_WELCOME_BODY" desc="Introductory body text on the first onboarding screen.">
  Focus Browser removes distractions from the interface, so your attention stays on the task at hand.
</message>
<message name="IDS_FOCUS_ONBOARDING_WELCOME_EYEBROW" desc="Short product label above the first onboarding heading.">
  Focus Browser · built for focused work
</message>
<message name="IDS_FOCUS_ONBOARDING_WELCOME_FEATURES_LABEL" desc="Accessible label for the focus benefits listed on the welcome screen.">
  Focus Browser benefits
</message>
<message name="IDS_FOCUS_ONBOARDING_WELCOME_FEATURE_QUIET" desc="Welcome screen benefit describing fewer interruptions.">
  Fewer distractions
</message>
<message name="IDS_FOCUS_ONBOARDING_WELCOME_FEATURE_CLEAN" desc="Welcome screen benefit describing a clean interface.">
  Clean interface
</message>
<message name="IDS_FOCUS_ONBOARDING_WELCOME_FEATURE_INTENT" desc="Welcome screen benefit describing intentional work.">
  Built for deep work
</message>
<message name="IDS_FOCUS_ONBOARDING_WELCOME_TERMS_NOTE" desc="Legal note prefix before privacy policy and terms links.">
  By continuing, you accept the
</message>
<message name="IDS_FOCUS_ONBOARDING_WELCOME_TERMS_PRIVACY" desc="Privacy policy link text in the onboarding legal note.">
  privacy policy
</message>
<message name="IDS_FOCUS_ONBOARDING_WELCOME_TERMS_AND" desc="Conjunction between privacy policy and terms links in the onboarding legal note.">
  and
</message>
<message name="IDS_FOCUS_ONBOARDING_WELCOME_TERMS_USE" desc="Terms of use link text in the onboarding legal note.">
  terms of use
</message>
<message name="IDS_FOCUS_ONBOARDING_WELCOME_FOOTER" desc="Footer text explaining that setup choices remain under user control.">
  You can change every selected option later in settings.
</message>

<message name="IDS_FOCUS_ONBOARDING_FOCUS_TITLE" desc="Title of the onboarding step for focus-oriented defaults.">
  Set up your work preferences
</message>
<message name="IDS_FOCUS_ONBOARDING_FOCUS_SUBTITLE" desc="Subtitle of the onboarding step for focus-oriented defaults.">
  Choose a calm interface with fewer distractions. You can change these options later.
</message>
<message name="IDS_FOCUS_ONBOARDING_FOCUS_QUIET_TITLE" desc="Title of the option to block website notification prompts.">
  Quiet notifications
</message>
<message name="IDS_FOCUS_ONBOARDING_FOCUS_QUIET_DESC" desc="Description of the option to block website notification prompts.">
  Stop websites from interrupting you with notification requests.
</message>
<message name="IDS_FOCUS_ONBOARDING_FOCUS_MINIMAL_TITLE" desc="Title of the option to use a minimal browser interface.">
  Minimal interface
</message>
<message name="IDS_FOCUS_ONBOARDING_FOCUS_MINIMAL_DESC" desc="Description of the option to use a minimal browser interface.">
  Hides the Home button and bookmarks bar. Your bookmarks remain available in the menu.
</message>
<message name="IDS_FOCUS_ONBOARDING_FOCUS_MOTION_TITLE" desc="Title of the option to enable smooth motion in Focus-owned interfaces.">
  Smooth animations
</message>
<message name="IDS_FOCUS_ONBOARDING_FOCUS_MOTION_DESC" desc="Description of the option to enable smooth motion in Focus-owned interfaces.">
  Adds calm, fluid transitions. The system reduced-motion setting always takes priority.
</message>
<message name="IDS_FOCUS_ONBOARDING_FOCUS_NOTE" desc="Note below focus preset options explaining that choices are reversible.">
  You can change every selected option later in browser settings.
</message>

<message name="IDS_FOCUS_ONBOARDING_APPEARANCE_TITLE" desc="Title of the onboarding step for choosing the address bar style.">
  Set up the address bar
</message>
<message name="IDS_FOCUS_ONBOARDING_APPEARANCE_SUBTITLE" desc="Subtitle of the onboarding step for choosing the address bar style.">
  Choose a comfortable width for entering addresses and search queries.
</message>
<message name="IDS_FOCUS_ONBOARDING_APPEARANCE_BAR_TITLE" desc="Heading above address bar style choices.">
  Address bar style
</message>
<message name="IDS_FOCUS_ONBOARDING_APPEARANCE_BAR_FULL" desc="Full width address bar option.">
  Full width
</message>
<message name="IDS_FOCUS_ONBOARDING_APPEARANCE_BAR_FULL_DESC" desc="Description of the full width address bar option.">
  Maximum room for long addresses.
</message>
<message name="IDS_FOCUS_ONBOARDING_APPEARANCE_BAR_CENTERED" desc="Centered address bar option.">
  Centered
</message>
<message name="IDS_FOCUS_ONBOARDING_APPEARANCE_BAR_CENTERED_DESC" desc="Description of the centered address bar option.">
  A balanced layout for everyday work.
</message>
<message name="IDS_FOCUS_ONBOARDING_APPEARANCE_BAR_MINIMAL" desc="Minimal address bar option.">
  Minimal
</message>
<message name="IDS_FOCUS_ONBOARDING_APPEARANCE_BAR_MINIMAL_DESC" desc="Description of the minimal address bar option.">
  A compact field with minimal visual noise.
</message>
<message name="IDS_FOCUS_ONBOARDING_APPEARANCE_NOTE" desc="Note explaining that appearance choices remain available in settings.">
  You can change these options later under Settings → Appearance.
</message>

<message name="IDS_FOCUS_ONBOARDING_SHORTCUTS_TITLE" desc="Title of the onboarding step for selecting New Tab Page shortcuts.">
  What should stay close at hand?
</message>
<message name="IDS_FOCUS_ONBOARDING_SHORTCUTS_SUBTITLE" desc="Subtitle of the onboarding step for selecting New Tab Page shortcuts.">
  Choose shortcuts for the New Tab page. Nothing is selected by default.
</message>
<message name="IDS_FOCUS_ONBOARDING_SHORTCUTS_SOCIAL" desc="Heading for social media shortcut choices.">
  Social media
</message>
<message name="IDS_FOCUS_ONBOARDING_SHORTCUTS_CODING" desc="Heading for coding shortcut choices.">
  Coding
</message>
<message name="IDS_FOCUS_ONBOARDING_SHORTCUTS_AI" desc="Heading for AI shortcut choices.">
  AI
</message>
<message name="IDS_FOCUS_ONBOARDING_SHORTCUTS_PRODUCTIVITY" desc="Heading for productivity shortcut choices.">
  Work and productivity
</message>
<message name="IDS_FOCUS_ONBOARDING_SHORTCUTS_EMPTY" desc="Status shown when no New Tab Page shortcuts are selected.">
  No shortcuts are selected. You can skip this step.
</message>
<message name="IDS_FOCUS_ONBOARDING_SHORTCUTS_SELECTED" desc="Prefix for the selected shortcut count.">
  Selected:
</message>
<message name="IDS_FOCUS_ONBOARDING_SHORTCUTS_LIMIT" desc="Message shown when the maximum number of shortcuts has been selected.">
  You can select up to 10 shortcuts.
</message>

<message name="IDS_FOCUS_ONBOARDING_FINISH_TITLE" desc="Title on the final onboarding screen.">
  You're ready to work
</message>
<message name="IDS_FOCUS_ONBOARDING_FINISH_BODY" desc="Body text on the final onboarding screen.">
  Focus Browser is set up. Open a task and focus on what matters.
</message>

<message name="IDS_FOCUS_ONBOARDING_SEARCH_TITLE" desc="Title of the onboarding screen for selecting a default search engine.">
  Search engine
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_SUBTITLE" desc="Subtitle for the onboarding screen for selecting a default search engine.">
  Choose your default search engine. You can change it later in settings.
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_LOADING" desc="Status shown while available search engines are loading.">
  Loading available search engines…
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_NONE" desc="Status shown when there are no available search engines.">
  No available search engines were found.
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_ERROR" desc="Status shown when available search engines could not be loaded.">
  Couldn't load the search engine list. You can continue with the current engine.
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_CATEGORIES_PRIVATE" desc="Description for privacy-first search engines in onboarding.">
  Privacy-first search without advertising profiles.
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_CATEGORIES_SMALL" desc="Description for smaller search engines that are more private than mainstream engines but not privacy-focused.">
  A more transparent alternative to the major search engines.
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_CATEGORIES_MAINSTREAM" desc="Description for mainstream search engines in onboarding.">
  A popular search engine that may collect data for personalization.
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_CATEGORIES_CUSTOM" desc="Description for a custom search engine in onboarding.">
  A custom search engine. Focus Browser hasn't reviewed its privacy policy.
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_ENGINES_DUCKDUCKGO" desc="Onboarding description of DuckDuckGo as a search engine option.">
  Privacy-focused. Uses Bing results and doesn't create an advertising profile.
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_ENGINES_KAGI" desc="Onboarding description of Kagi as a search engine option.">
  Search without ads or tracking and with customizable results. A paid account is required.
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_ENGINES_QWANT" desc="Onboarding description of Qwant as a search engine option.">
  A European search engine powered by Bing results.
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_ENGINES_ECOSIA" desc="Onboarding description of Ecosia as a search engine option.">
  Directs part of its advertising revenue to environmental projects. Uses Bing and Google results.
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_ENGINES_BING" desc="Onboarding description of Bing as a search engine option.">
  Microsoft's popular search engine, with personalized results and ads.
</message>
<message name="IDS_FOCUS_ONBOARDING_SEARCH_ENGINES_GOOGLE" desc="Onboarding description of Google as a search engine option.">
  Google's popular search engine, with personalized results and ads.
</message>

<message name="IDS_FOCUS_ONBOARDING_DEFAULT_BROWSER_TITLE" desc="Title of the onboarding screen asking whether Focus should be the default browser.">
  Make Focus Browser your default?
</message>
<message name="IDS_FOCUS_ONBOARDING_DEFAULT_BROWSER_SUBTITLE" desc="Subtitle of the onboarding screen asking whether Focus should be the default browser.">
  Links from other apps will open in Focus Browser. You can change this choice in Windows.
</message>
<message name="IDS_FOCUS_ONBOARDING_DEFAULT_BROWSER_YES" desc="Label for the option to make Focus the default browser.">
  Yes, make it default
</message>
<message name="IDS_FOCUS_ONBOARDING_DEFAULT_BROWSER_NO" desc="Label for the option to keep the current default browser.">
  Not now
</message>
<message name="IDS_FOCUS_ONBOARDING_DEFAULT_BROWSER_YES_DESC" desc="Description for the option to make Focus the default browser.">
  Open web links in Focus Browser.
</message>
<message name="IDS_FOCUS_ONBOARDING_DEFAULT_BROWSER_NO_DESC" desc="Description for the option to keep the current default browser.">
  Keep your current default browser.
</message>

<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_TITLE" desc="Title of the onboarding screen for importing browser data.">
  Bring your data from another browser
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_SUBTITLE" desc="Subtitle of the onboarding screen for importing browser data.">
  Choose a profile or import supported data from Google Chrome with one click.
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_SUBTITLE_NO_CHROME" desc="Import subtitle shown when no Google Chrome profile was found.">
  Choose a detected browser and the data you want to bring over.
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_BOOKMARKS" desc="Label for bookmarks as an importable data type.">
  Bookmarks
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_HISTORY" desc="Label for history as an importable data type.">
  History
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_EXTENSIONS" desc="Label for extensions as an importable data type.">
  Extensions
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_PASSWORDS" desc="Label for passwords as an importable data type.">
  Passwords
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_AUTOFILL" desc="Label for autofill data as an importable data type.">
  Autofill
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_SEARCH_ENGINE" desc="Label for the default search engine as an importable data type.">
  Search engine
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_LOADING" desc="Status shown while the list of importable browser profiles is loading.">
  Looking for installed browsers…
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_NONE" desc="Status shown when no importable browser profiles were found.">
  No profiles are available to import. You can continue without importing.
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_LOAD_ERROR" desc="Status shown when importable browser profiles could not be loaded.">
  Couldn't load the browser list. You can continue without importing.
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_IMPORTED" desc="Status shown for a profile that was already imported during onboarding.">
  Already imported
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_DEFAULT_PROFILE" desc="Fallback label for an importable browser profile without a name.">
  Default profile
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_CHROME_QUICK_TITLE" desc="Title of the one-click Chrome import card.">
  Import supported data from Google Chrome
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_CHROME_QUICK_DESC" desc="Description of the data included in one-click Chrome import.">
  Available bookmarks, history, and extensions.
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_CHROME_QUICK_BUTTON" desc="Button label that starts one-click Chrome import.">
  Import
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_CHROME_QUICK_WORKING" desc="Status shown while one-click Chrome import is running.">
  Importing…
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_CHROME_QUICK_DONE" desc="Status shown after one-click Chrome import succeeds.">
  Done
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_CHROME_QUICK_FAILED" desc="Status shown after one-click Chrome import fails.">
  Couldn't import the data. Try again or choose a profile below.
</message>
<message name="IDS_FOCUS_ONBOARDING_DATA_IMPORT_CHROME_QUICK_RETRY" desc="Button label that retries one-click Chrome import after an error.">
  Try again
</message>

<message name="IDS_FOCUS_ONBOARDING_PASSWORD_TITLE" desc="Title of the onboarding screen for the built-in password manager.">
  Focus Password Manager
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_SUBTITLE" desc="Subtitle of the onboarding screen for the built-in password manager.">
  Built into the browser and enabled by default. There's nothing else to install.
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_LOCAL_TITLE" desc="Title of the local password storage benefit.">
  Protected local storage
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_LOCAL_DESC" desc="Description of local password storage in the built-in password manager.">
  Passwords are encrypted by Windows and stored in your Focus Browser profile.
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_FILL_TITLE" desc="Title of the password autofill and generation benefit.">
  Autofill and generation
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_FILL_DESC" desc="Description of password autofill and generation.">
  Focus Browser saves, fills, and creates strong passwords directly on websites.
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_PASSKEYS_TITLE" desc="Title of the passwords and passkeys benefit.">
  Passwords and passkeys
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_PASSKEYS_DESC" desc="Description of passwords and passkeys management.">
  Manage saved sign-in details and supported passkeys in one place.
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_OPEN_MANAGER" desc="Button label that opens the built-in password manager.">
  Open manager
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_OPEN_IMPORT" desc="Button label that opens password import settings.">
  Import passwords
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_NOTE" desc="Note explaining how Chrome passwords can be imported separately.">
  Chrome passwords are not included in browser data import. Export them from Chrome, then use Import passwords above.
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_IMPORT_GUIDE" desc="Button label linking to a password manager import guide.">
  Import
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_SETUP_GUIDE" desc="Button label linking to a password manager setup guide.">
  Setup
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_PRIVACY" desc="Button label linking to a password manager privacy policy.">
  Privacy
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_INSTALL" desc="Button label to install a password manager extension.">
  Install
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_INSTALLED" desc="Status label shown when a password manager extension is installed.">
  Installed
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_ERROR" desc="Prefix label shown before a password manager install error.">
  Error:
</message>

<message name="IDS_FOCUS_ONBOARDING_PASSWORD_MANAGERS_PROTON_PASS" desc="Onboarding description of Proton Pass as a password manager option.">
  Proton's open-source password manager with a free plan.
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_MANAGERS_BITWARDEN" desc="Onboarding description of Bitwarden as a password manager option.">
  A popular open-source password manager with a free plan and self-hosting support.
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_MANAGERS_ONE_PASSWORD" desc="Onboarding description of 1Password as a password manager option.">
  A paid, closed-source password manager.
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_MANAGERS_DASHLANE" desc="Onboarding description of Dashlane as a password manager option.">
  A paid, closed-source password manager with data storage in Europe.
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_MANAGERS_ICLOUD_PASSWORDS" desc="Onboarding description of iCloud Passwords as a password manager option.">
  Apple's free password manager. On Windows it may require signing in again after a browser restart.
</message>
<message name="IDS_FOCUS_ONBOARDING_PASSWORD_MANAGERS_KEE_PASS_XC" desc="Onboarding description of KeePassXC as a password manager option.">
  A local, free, open-source password manager for advanced users.
</message>

</grit-part>
