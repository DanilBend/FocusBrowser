# The public native-engine dependency keeps the generated CXX types and the
# Chromium public-suffix resolver linked together for browser-side consumers.
group("native_engine") {
  public_deps = [
    "//components/focus_block/rs:rust_lib",
    "//components/focus_block/rs/resolver",
  ]
}
