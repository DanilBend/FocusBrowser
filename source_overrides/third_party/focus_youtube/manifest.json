{
  "manifest_version": 3,
  "name": "FocusYoutube",
  "short_name": "FocusYoutube",
  "description": "Встроенная защита Focus Browser от отвлекающих элементов YouTube.",
  "author": "Focus Browser",
  "version": "1.6.9.1",
  "minimum_chrome_version": "120",
  "key": "",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "FocusYoutube — режим без отвлечений"
  },
  "background": {
    "service_worker": "background/events.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "css": [
        "content-script/main.css"
      ],
      "js": [
        "shared/utils.js",
        "shared/main.js",
        "content-script/main.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://youtube.com/*",
    "https://*.youtube.com/*"
  ]
}
