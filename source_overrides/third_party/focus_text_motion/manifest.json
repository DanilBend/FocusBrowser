{
  "manifest_version": 3,
  "name": "Focus Text Motion",
  "short_name": "Focus Motion",
  "description": "Built-in Focus Browser text-entry motion for web pages.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "key": "",
  "incognito": "split",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "settingsPrivate",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
