import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "meditation"

  static_files = [
    "meditation.css",
    "meditation.html",
  ]

  ts_files = [ "meditation.ts" ]
  ts_deps = [ "//ui/webui/resources/js:build_ts" ]
  webui_context_type = "trusted"
}
