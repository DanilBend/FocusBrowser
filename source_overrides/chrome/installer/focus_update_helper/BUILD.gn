import("//build/config/win/manifest.gni")
import("//chrome/updater/winsparkle.gni")

assert(is_win)

windows_manifest("focus_update_helper_manifest") {
  sources = [
    as_invoker_manifest,
    common_controls_manifest,
  ]
}

executable("focus_update_helper") {
  output_name = "focus_update_helper"

  sources = [
    "event_log.cc",
    "focus_update_helper.rc",
    "focus_update_helper_internal.h",
    "focus_update_helper_main.cc",
    "localized_strings.cc",
    "payload_verifier.cc",
    "progress_dialog.cc",
    "update_installer.cc",
  ]

  inputs = [ "//chrome/app/theme/chromium/win/chromium.ico" ]

  configs -= [ "//build/config/win:console" ]
  configs += [ "//build/config/win:windowed" ]

  deps = [
    ":focus_update_helper_manifest",
    "//base",
    "//chrome/installer/util:strings",
    "//third_party/boringssl",
  ]

  defines = [
    "FOCUS_AUTHENTICODE_ORG=L\"$winsparkle_authenticode_org\"",
    "FOCUS_EDDSA_PUBKEY=\"$winsparkle_ed_key\"",
  ]

  libs = [
    "advapi32.lib",
    "comctl32.lib",
    "crypt32.lib",
    "ole32.lib",
    "oleaut32.lib",
    "shell32.lib",
    "wintrust.lib",
  ]
}

test("focus_update_helper_unittests") {
  testonly = true

  sources = [
    "event_log.cc",
    "payload_verifier.cc",
    "payload_verifier_unittest.cc",
    "update_install_status_unittest.cc",
  ]

  defines = [
    "FOCUS_AUTHENTICODE_ORG=L\"\"",
    "FOCUS_EDDSA_PUBKEY=\"PUAXw+hDiVqStwqnTRt+vJyYLM8uxJaMwM1V8Sr0Zgw=\"",
  ]

  deps = [
    "//base",
    "//base/test:run_all_unittests",
    "//testing/gtest",
    "//third_party/boringssl",
  ]

  libs = [
    "advapi32.lib",
    "crypt32.lib",
    "wintrust.lib",
  ]
}
