--- a/chrome/installer/setup/setup_main.cc
+++ b/chrome/installer/setup/setup_main.cc
@@ -597,6 +597,14 @@ installer::InstallStatus RenameChromeExecutables(
 
   installer::InstallStatus ret = installer::RENAME_SUCCESSFUL;
   if (install_list->Do()) {
+    // The in-use update path rewrites shortcuts while chrome.exe still points
+    // at the running, old binary. Invalidate the Shell's cached image only
+    // after new_chrome.exe has actually replaced chrome.exe.
+    ::SHChangeNotify(SHCNE_UPDATEITEM,
+                     SHCNF_PATHW | SHCNF_FLUSHNOWAIT,
+                     chrome_exe.value().c_str(), nullptr);
+    ::SHChangeNotify(SHCNE_ASSOCCHANGED,
+                     SHCNF_IDLIST | SHCNF_FLUSHNOWAIT, nullptr, nullptr);
     installer::LaunchDeleteOldVersionsProcess(setup_exe, *installer_state);
   } else {
     LOG(ERROR) << "Renaming of executables failed. Rolling back any changes.";
--- a/chrome/installer/setup/install.cc
