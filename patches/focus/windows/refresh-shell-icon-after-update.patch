@@ -493,6 +493,19 @@ InstallStatus InstallOrUpdateProduct(const InstallParams& install_params,
               .Append(setup_path.BaseName());
       LaunchDeleteOldVersionsProcess(new_version_setup_path, installer_state);
     }
+
+    if (!is_in_use) {
+      // chrome.exe already contains the newly installed icon. Tell Explorer to
+      // discard shortcut, taskbar, and file-association images cached for the
+      // stable executable path.
+      const base::FilePath chrome_exe =
+          installer_state.target_path().Append(kChromeExe);
+      ::SHChangeNotify(SHCNE_UPDATEITEM,
+                       SHCNF_PATHW | SHCNF_FLUSHNOWAIT,
+                       chrome_exe.value().c_str(), nullptr);
