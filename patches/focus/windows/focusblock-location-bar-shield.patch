+void LocationBarView::RefreshFocusBlockButtonIcon() {
+  if (!focus_block_button_) {
+    return;
+  }
+
+  views::SetImageFromVectorIconWithColor(
+      focus_block_button_, vector_icons::kShieldIcon,
+      views::IconColors(kColorOmniboxActionIcon, kColorOmniboxActionIcon,
+                        kColorOmniboxActionIconHover),
+      GetLayoutConstant(LayoutConstant::kLocationBarTrailingIconSize));
+  focus_block_button_->SetBorder(views::CreateEmptyBorder(
+      GetLayoutInsets(LOCATION_BAR_PAGE_ACTION_ICON_PADDING)));
+}
+
+void LocationBarView::FocusBlockButtonPressed(const ui::Event&) {
+  if (delegate_ && focus_block_button_) {
+    delegate_->ShowFocusBlockPopup(focus_block_button_);
+  }
+}
+
+void LocationBarView::SetFocusBlockButtonVisible(bool visible) {
+  if (!focus_block_button_ || focus_block_button_->GetVisible() == visible) {
+    return;
+  }
+  if (!visible) {
+    if (views::DialogDelegate* bubble =
+            focus_block_button_->GetProperty(views::kAnchoredDialogKey)) {
+      if (views::Widget* widget = bubble->GetWidget()) {
+        widget->Close();
+      }
+    }
+  }
+  focus_block_button_->SetVisible(visible);
+  InvalidateLayout();
+}
+
 bool LocationBarView::ShouldShowKeywordBubble() const {
   return GetOmniboxController()->edit_model()->is_keyword_selected();
