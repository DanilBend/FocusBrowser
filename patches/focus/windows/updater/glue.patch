+class WinSparkleController : public ProfileObserver,
+                             public ProfileManagerObserver,
+                             public BrowserCollectionObserver {
+  enum class CheckState {
+    kIdle,
+    kBackground,
+    kInteractive,
+  };
+
+ public:
+  static WinSparkleController& GetInstance() {
+    static base::NoDestructor<WinSparkleController> instance;
+    return *instance;
+  }
+
+  void Start(Profile* initial_profile) {
+    if (started_) {
+      return;
+    }
+    started_ = true;
+    app_terminating_subscription_ =
+        browser_shutdown::AddAppTerminatingCallback(base::BindOnce(
+            &WinSparkleController::OnAppTerminating,
+            base::Unretained(this)));
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+        base::BindOnce(&ClearStaleSystemUpdateMarker));
+    if (ProfileManager* manager = GetProfileManager()) {
+      profile_manager_observation_.Observe(manager);
+    }
+    if (GlobalBrowserCollection* browsers =
+            GlobalBrowserCollection::GetInstance()) {
+      browser_collection_observation_.Observe(browsers);
+    }
+    DiscardObsoleteStoredUpdate();
+    AcquireProfile(initial_profile, /*exclude=*/nullptr);
+    if (GlobalBrowserCollection* browsers =
+            GlobalBrowserCollection::GetInstance()) {
+      if (BrowserWindowInterface* browser = browsers->GetLastActiveBrowser()) {
+        MaybeShowUpdatePrompt(browser);
+        MaybeStartStartupCheck(browser);
+      }
+    }
+    ScheduleStartupUiRetry();
+  }
+
+  void RequestInteractiveCheckFromAbout() {
+    RequestInteractiveCheck(/*dismiss_custom_prompt=*/true);
+  }
+
+  void RequestInteractiveCheck(bool dismiss_custom_prompt) {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (shutdown_started_ || !initialized_ || !profile_ ||
+        !ProfileCanUpdate(profile_)) {
+      PostStatus(VersionUpdater::DISABLED);
+      return;
+    }
+
+    if (dismiss_custom_prompt && prompt_visible_ && update_prompt_widget_) {
+      update_prompt_widget_->Close();
+    }
+
+    if (check_state_ == CheckState::kInteractive) {
+      return;
+    }
+    if (check_state_ == CheckState::kBackground) {
+      interactive_check_pending_ = true;
+      return;
+    }
+    StartInteractiveCheck();
+  }
+
+  void OnUpdateFound(const std::string& version, uint64_t generation) {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (!RuntimeAcceptsCallback(generation) ||
+        check_state_ == CheckState::kIdle) {
+      return;
+    }
+    if (check_state_ == CheckState::kInteractive) {
+      if (!RecordDiscoveredVersion(version, /*offer_immediately=*/false)) {
+        FinishUpdateCheckWithError(
+            u"The update service returned an invalid version.");
+        return;
+      }
+      PostStatus(VersionUpdater::UPDATING, /*progress=*/0, std::u16string(),
+                 /*require_active_callbacks=*/true, generation);
+      return;
+    }
+
+    const bool run_interactive = interactive_check_pending_;
+    if (!RecordDiscoveredVersion(version,
+                                 /*offer_immediately=*/!run_interactive)) {
+      FinishUpdateCheckWithError(
+          u"The update service returned an invalid version.");
+      return;
+    }
+    interactive_check_pending_ = false;
+    check_state_ = CheckState::kIdle;
+    if (run_interactive) {
+      QueueInteractiveCheckAfterWorkerExit();
+      return;
+    }
+  }
+
+  void OnNoUpdateAvailable(uint64_t generation) {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (!RuntimeAcceptsCallback(generation) ||
+        check_state_ == CheckState::kIdle) {
+      return;
+    }
+    interactive_check_pending_ = false;
+    check_state_ = CheckState::kIdle;
+    current_feed_discovery_succeeded_ = false;
+    ClearDiscoveredVersion();
+    PostStatus(VersionUpdater::UPDATED, /*progress=*/0, std::u16string(),
+               /*require_active_callbacks=*/true, generation);
+  }
+
+  void OnUpdateError(const std::u16string& message, uint64_t generation) {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (!RuntimeAcceptsCallback(generation) ||
+        check_state_ == CheckState::kIdle) {
+      return;
+    }
+    FinishUpdateCheckWithError(message);
+  }
+
+  void FinishUpdateCheckWithError(const std::u16string& message) {
+    const bool run_interactive =
+        check_state_ == CheckState::kBackground && interactive_check_pending_;
+    interactive_check_pending_ = false;
+    check_state_ = CheckState::kIdle;
+    current_feed_discovery_succeeded_ = false;
+    if (run_interactive) {
+      QueueInteractiveCheckAfterWorkerExit();
+      return;
+    }
+    PostStatus(VersionUpdater::FAILED, /*progress=*/0, message,
+               /*require_active_callbacks=*/true, callback_generation_);
+  }
+
+  bool RecordDiscoveredVersion(const std::string& version,
+                               bool offer_immediately) {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    PrefService* local_state = GetUpdaterLocalState();
+    if (!local_state || !IsAvailableVersionNewerThanCurrent(version)) {
+      return false;
+    }
+    current_feed_discovery_succeeded_ = true;
+
+    const std::string stored =
+        local_state->GetString(prefs::kFocusUpdaterAvailableVersion);
+    if (IsNewUpdateDiscovery(stored, version)) {
+      local_state->SetString(prefs::kFocusUpdaterAvailableVersion, version);
+      if (offer_immediately) {
+        local_state->ClearPref(prefs::kFocusUpdaterSuppressedSession);
+      }
+      if (local_state->GetString(prefs::kFocusUpdaterSkippedVersion) !=
+          version) {
+        local_state->ClearPref(prefs::kFocusUpdaterSkippedVersion);
+      }
+    }
+
+    if (!offer_immediately) {
+      local_state->SetString(prefs::kFocusUpdaterSuppressedSession,
+                             SessionToken());
+      return true;
+    }
+
+    if (GlobalBrowserCollection* browsers =
+            GlobalBrowserCollection::GetInstance()) {
+      MaybeShowUpdatePrompt(browsers->GetLastActiveBrowser());
+    }
+    return true;
+  }
+
+  void ClearDiscoveredVersion() {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    PrefService* local_state = GetUpdaterLocalState();
+    if (!local_state) {
+      return;
+    }
+    local_state->ClearPref(prefs::kFocusUpdaterAvailableVersion);
+    local_state->ClearPref(prefs::kFocusUpdaterSuppressedSession);
+  }
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override {
+    MaybeShowUpdatePrompt(browser);
+    MaybeStartStartupCheck(browser);
+    ScheduleStartupUiRetry();
+  }
+
+  void OnBrowserActivated(BrowserWindowInterface* browser) override {
+    MaybeShowUpdatePrompt(browser);
+    MaybeStartStartupCheck(browser);
+  }
+
+  // ProfileManagerObserver:
+  void OnProfileAdded(Profile* new_profile) override {
+    if (shutdown_started_) {
+      return;
+    }
+    if (!profile_) {
+      AcquireProfile(new_profile, /*exclude=*/nullptr);
+    } else if (!ProfileCanUpdate(profile_) && ProfileCanUpdate(new_profile) &&
+               IsCandidate(new_profile)) {
+      // The active profile isn't asking for updates but this new
+      // one is; let it take over.
+      Unbind();
+      Bind(new_profile);
+    }
+  }
+
+  void OnProfileManagerDestroying() override {
+    profile_manager_observation_.Reset();
+  }
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override {
+    DCHECK_EQ(profile, profile_);
+    Unbind();
+    if (!shutdown_started_) {
+      AcquireProfile(/*preferred=*/nullptr, /*exclude=*/profile);
+    }
+  }
+
+ private:
+  friend class base::NoDestructor<WinSparkleController>;
+  WinSparkleController() = default;
+  ~WinSparkleController() override = default;
+
+  static ProfileManager* GetProfileManager() {
+    return g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  }
+
+  static bool IsCandidate(Profile* profile) {
+    return profile && profile->IsRegularProfile();
+  }
+
+  static bool ProfileCanUpdate(Profile* profile) {
+    return profile && focus::WinSparkleEnabled(profile->GetPrefs());
+  }
+
+  bool RuntimeAcceptsCallback(uint64_t generation) const {
+    return !shutdown_started_ && initialized_ &&
+           callback_generation_ == generation &&
+           UpdaterCallbacksEnabledForGeneration(generation);
+  }
+
+  void DiscardObsoleteStoredUpdate() {
+    PrefService* local_state = GetUpdaterLocalState();
+    if (!local_state) {
+      return;
+    }
+    const std::string available =
+        local_state->GetString(prefs::kFocusUpdaterAvailableVersion);
+    if (available.empty() || IsAvailableVersionNewerThanCurrent(available)) {
+      return;
+    }
+    local_state->ClearPref(prefs::kFocusUpdaterAvailableVersion);
+    local_state->ClearPref(prefs::kFocusUpdaterSuppressedSession);
+    if (local_state->GetString(prefs::kFocusUpdaterSkippedVersion) ==
+        available) {
+      local_state->ClearPref(prefs::kFocusUpdaterSkippedVersion);
+    }
+  }
+
+  void MaybeShowUpdatePrompt(BrowserWindowInterface* browser) {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (shutdown_started_ || !initialized_ ||
+        !current_feed_discovery_succeeded_) {
+      return;
+    }
+    if (prompt_visible_) {
+      VLOG(1) << "Focus updater: startup prompt already visible";
+      return;
+    }
+    if (!browser) {
+      VLOG(1) << "Focus updater: startup prompt waiting for a browser";
+      return;
+    }
+    if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        !browser->GetProfile() ||
+        !browser->GetProfile()->IsRegularProfile()) {
+      VLOG(1) << "Focus updater: startup prompt skipped for a non-regular "
+                 "browser";
+      return;
+    }
+    if (!ProfileCanUpdate(browser->GetProfile())) {
+      VLOG(1) << "Focus updater: startup prompt disabled by profile consent";
+      return;
+    }
+
+    PrefService* local_state = GetUpdaterLocalState();
+    if (!local_state) {
+      VLOG(1) << "Focus updater: startup prompt waiting for Local State";
+      return;
+    }
+    const std::string available =
+        local_state->GetString(prefs::kFocusUpdaterAvailableVersion);
+    if (!IsAvailableVersionNewerThanCurrent(available)) {
+      VLOG(1) << "Focus updater: no newer stored version to offer; stored='"
+              << available << "' current='"
+              << version_info::GetFocusVersionNumber() << "'";
+      return;
+    }
+    if (!ShouldOfferStoredUpdate(
+            available,
+            local_state->GetString(prefs::kFocusUpdaterSkippedVersion),
+            local_state->GetString(prefs::kFocusUpdaterSuppressedSession),
+            SessionToken())) {
+      VLOG(1) << "Focus updater: stored version is skipped or suppressed";
+      return;
+    }
+
+    Browser* legacy_browser = browser->GetBrowserForMigrationOnly();
+    if (!legacy_browser || !legacy_browser->window()) {
+      VLOG(1) << "Focus updater: startup prompt waiting for a native window";
+      return;
+    }
+
+    // Mark the process session before creating the widget. This makes both
+    // window close and any activation reentrancy a single prompt per launch.
+    local_state->SetString(prefs::kFocusUpdaterSuppressedSession,
+                           SessionToken());
+    prompt_visible_ = true;
+    auto prompt = std::make_unique<FocusUpdatePrompt>(
+        available,
+        base::BindOnce(&WinSparkleController::OnUpdatePromptResult,
+                       base::Unretained(this)),
+        base::BindOnce(
+            &WinSparkleController::OnUpdatePromptWidgetBecameZombie,
+            base::Unretained(this)));
+    prompt->SetOwnershipOfNewWidget(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+    update_prompt_ = std::move(prompt);
+    update_prompt_widget_.reset(views::DialogDelegate::CreateDialogWidget(
+        update_prompt_.get(), legacy_browser->window()->GetNativeWindow(),
+        nullptr));
+    update_prompt_widget_->MakeCloseSynchronous(base::BindOnce(
+        &WinSparkleController::OnUpdatePromptCloseRequested,
+        base::Unretained(this)));
+    update_prompt_widget_->Show();
+    VLOG(1) << "Focus updater: startup prompt shown";
+  }
+
+  void MaybeStartStartupCheck(BrowserWindowInterface* browser) {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    Browser* legacy_browser =
+        browser ? browser->GetBrowserForMigrationOnly() : nullptr;
+    if (shutdown_started_ || startup_check_started_ || prompt_visible_ ||
+        !initialized_ || !browser ||
+        browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        !browser->GetProfile() || !browser->GetProfile()->IsRegularProfile() ||
+        !legacy_browser || !legacy_browser->window() ||
+        !ProfileCanUpdate(browser->GetProfile()) ||
+        !BUILDFLAG(WINSPARKLE_AUTOMATIC_CHECKS)) {
+      return;
+    }
+
+    startup_check_started_ = RequestBackgroundCheck();
+    if (startup_check_started_) {
+      startup_ui_retry_timer_.Stop();
+    }
+  }
+
+  void ScheduleStartupUiRetry() {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (shutdown_started_ || !initialized_ || startup_check_started_ ||
+        prompt_visible_ ||
+        startup_ui_retry_timer_.IsRunning()) {
+      return;
+    }
+    startup_ui_retry_count_ = 0;
+    startup_ui_retry_timer_.Start(
+        FROM_HERE, base::Milliseconds(100),
+        base::BindRepeating(&WinSparkleController::RetryStartupUi,
+                            base::Unretained(this)));
+  }
+
+  void RetryStartupUi() {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (shutdown_started_ || !initialized_ || !profile_ ||
+        !ProfileCanUpdate(profile_) ||
+        !BUILDFLAG(WINSPARKLE_AUTOMATIC_CHECKS) ||
+        startup_ui_retry_count_++ >= 50) {
+      startup_ui_retry_timer_.Stop();
+      return;
+    }
+    if (GlobalBrowserCollection* browsers =
+            GlobalBrowserCollection::GetInstance()) {
+      if (BrowserWindowInterface* browser = browsers->GetLastActiveBrowser()) {
+        MaybeShowUpdatePrompt(browser);
+        MaybeStartStartupCheck(browser);
+      }
+    }
+    if (prompt_visible_ || startup_check_started_) {
+      startup_ui_retry_timer_.Stop();
+    }
+  }
+
+  void OnUpdatePromptResult(UpdatePromptResult result,
+                            const std::string& version) {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (shutdown_started_ || !initialized_) {
+      return;
+    }
+    switch (result) {
+      case UpdatePromptResult::kUpdateNow:
+        // This is the only prompt action that starts an update download.
+        RequestInteractiveCheck(/*dismiss_custom_prompt=*/false);
+        return;
+      case UpdatePromptResult::kRemindLater:
+        return;
+      case UpdatePromptResult::kSkipVersion:
+        if (PrefService* local_state = GetUpdaterLocalState()) {
+          const std::string available = local_state->GetString(
+              prefs::kFocusUpdaterAvailableVersion);
+          if (available == version) {
+            local_state->SetString(prefs::kFocusUpdaterSkippedVersion,
+                                   version);
+          }
+        }
+        return;
+    }
+  }
+
+  void OnUpdatePromptCloseRequested(views::Widget::ClosedReason) {
+    ScheduleUpdatePromptDestruction();
+  }
+
+  void OnUpdatePromptWidgetBecameZombie() {
+    ScheduleUpdatePromptDestruction();
+  }
+
+  void ScheduleUpdatePromptDestruction() {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (shutdown_started_ || !initialized_) {
+      return;
+    }
+    if (update_prompt_) {
+      update_prompt_->ResolveIfPending(UpdatePromptResult::kRemindLater);
+    }
+    if (prompt_destruction_scheduled_) {
+      return;
+    }
+    prompt_destruction_scheduled_ = true;
+    content::GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE,
+        base::BindOnce(&WinSparkleController::DestroyUpdatePrompt,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void DestroyUpdatePrompt() {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    update_prompt_widget_.reset();
+    update_prompt_.reset();
+    prompt_destruction_scheduled_ = false;
+    prompt_visible_ = false;
+  }
+
+  // Adopts a profile to drive updates if none is active. No-op if one
+  // is already active or none qualifies.
+  void AcquireProfile(Profile* preferred, Profile* exclude) {
+    if (shutdown_started_ || profile_) {
+      return;
+    }
+
+    if (preferred != exclude && IsCandidate(preferred)) {
+      Bind(preferred);
+      return;
+    }
+
+    ProfileManager* manager = GetProfileManager();
+    if (!manager) {
+      return;
+    }
+
+    Profile* fallback = nullptr;
+    for (Profile* profile : manager->GetLoadedProfiles()) {
+      if (profile == exclude || !IsCandidate(profile)) {
+        continue;
+      }
+      if (ProfileCanUpdate(profile)) {
+        Bind(profile);
+        return;
+      }
+      if (!fallback) {
+        fallback = profile;
+      }
+    }
+    if (fallback) {
+      Bind(fallback);
+    }
+  }
+
+  void Bind(Profile* profile) {
+    DCHECK(!profile_);
+    if (shutdown_started_) {
+      return;
+    }
+    profile_ = profile;
+    profile_observation_.Observe(profile);
+    registrar_.Init(profile->GetPrefs());
+    registrar_.Add(
+        prefs::kFocusUpdateFetchingEnabled,
+        base::BindRepeating(&WinSparkleController::ApplyUpdaterState,
+                            base::Unretained(this)));
+    ApplyUpdaterState();
+  }
+
+  void Unbind() {
+    StopUpdaterRuntime();
+    registrar_.RemoveAll();
+    profile_observation_.Reset();
+    profile_ = nullptr;
+  }
+
+  void OnAppTerminating() {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (shutdown_started_) {
+      return;
+    }
+    shutdown_started_ = true;
+    StopUpdaterRuntime();
+    registrar_.RemoveAll();
+    profile_observation_.Reset();
+    profile_ = nullptr;
+    browser_collection_observation_.Reset();
+    profile_manager_observation_.Reset();
+  }
+
+  void StopUpdaterRuntime() {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    const bool was_initialized = initialized_;
+
+    // Invalidate native callbacks and already-posted UI work before releasing
+    // WinSparkle state. Bump the generation so a late callback from an old
+    // one-shot worker cannot be accepted after consent is enabled again.
+    g_updater_callbacks_enabled.store(false, std::memory_order_release);
+    g_updater_callback_generation.fetch_add(1, std::memory_order_acq_rel);
+    callback_generation_ = 0;
+    initialized_ = false;
+    current_feed_discovery_succeeded_ = false;
+    check_state_ = CheckState::kIdle;
+    interactive_check_pending_ = false;
+    startup_check_started_ = false;
+    startup_ui_retry_count_ = 0;
+    periodic_check_timer_.Stop();
+    queued_interactive_check_timer_.Stop();
+    startup_ui_retry_timer_.Stop();
+    weak_factory_.InvalidateWeakPtrs();
+
+    if (update_prompt_) {
+      update_prompt_->ResolveIfPending(UpdatePromptResult::kRemindLater);
+    }
+    update_prompt_widget_.reset();
+    update_prompt_.reset();
+    prompt_visible_ = false;
+    prompt_destruction_scheduled_ = false;
+
+    if (!was_initialized) {
+      return;
+    }
+    win_sparkle_set_automatic_check_for_updates(0);
+    win_sparkle_cleanup();
+  }
+
+  bool RequestBackgroundCheck() {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (shutdown_started_ || check_state_ != CheckState::kIdle ||
+        !initialized_ || !profile_ ||
+        !ProfileCanUpdate(profile_) ||
+        !BUILDFLAG(WINSPARKLE_AUTOMATIC_CHECKS)) {
+      return false;
+    }
+    current_feed_discovery_succeeded_ = false;
+    check_state_ = CheckState::kBackground;
+    win_sparkle_check_update_without_ui();
+    return true;
+  }
+
+  void RequestPeriodicBackgroundCheck() {
+    RequestBackgroundCheck();
+  }
+
+  void RunQueuedInteractiveCheck() {
+    if (shutdown_started_ || !initialized_) {
+      return;
+    }
+    RequestInteractiveCheck(/*dismiss_custom_prompt=*/false);
+  }
+
+  void QueueInteractiveCheckAfterWorkerExit() {
+    // WinSparkle invokes the result callback at the end of its one-shot worker.
+    // Defer starting the requested interactive worker until that callback has
+    // returned and the self-owned background worker has fully unwound.
+    queued_interactive_check_timer_.Start(
+        FROM_HERE, base::Milliseconds(100),
+        base::BindOnce(&WinSparkleController::RunQueuedInteractiveCheck,
+                       base::Unretained(this)));
+  }
+
+  void StartInteractiveCheck() {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    current_feed_discovery_succeeded_ = false;
+    check_state_ = CheckState::kInteractive;
+    win_sparkle_check_update_with_ui_and_install();
+  }
+
+  void StartPeriodicCheckTimer() {
+    if (shutdown_started_ || !initialized_ ||
+        !BUILDFLAG(WINSPARKLE_AUTOMATIC_CHECKS) ||
+        periodic_check_timer_.IsRunning()) {
+      return;
+    }
+    periodic_check_timer_.Start(
+        FROM_HERE, base::Seconds(BUILDFLAG(WINSPARKLE_CHECK_INTERVAL)),
+        base::BindRepeating(
+            &WinSparkleController::RequestPeriodicBackgroundCheck,
+            base::Unretained(this)));
+  }
+
+  void ApplyUpdaterState() {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (shutdown_started_ || !profile_) {
+      return;
+    }
+    PrefService* prefs = profile_->GetPrefs();
+    const bool enabled = focus::WinSparkleEnabled(prefs);
+
+    if (!enabled) {
+      StopUpdaterRuntime();
+      return;
+    }
+
+    if (!initialized_) {
+
+      base::FilePath module_dir;
+      if (base::PathService::Get(base::DIR_MODULE, &module_dir)) {
+        ::LoadLibraryW(
+            module_dir.Append(FILE_PATH_LITERAL("WinSparkle.dll"))
+                .value()
+                .c_str());
+      }
+
+      const std::wstring version =
+          base::UTF8ToWide(std::string(version_info::GetFocusVersionNumber()));
+      win_sparkle_set_app_details(L"Focus Browser", L"Focus Browser",
+                                  version.c_str());
+      win_sparkle_set_eddsa_public_key(BUILDFLAG(WINSPARKLE_ED_KEY));
+      RegisterWinSparkleCallbacks();
+      win_sparkle_set_update_check_interval(
+          BUILDFLAG(WINSPARKLE_CHECK_INTERVAL));
+      // Focus owns scheduling so startup, periodic, and About-page checks are
+      // serialized through this controller instead of racing WinSparkle's
+      // internal periodic worker.
+      win_sparkle_set_automatic_check_for_updates(0);
+
+      ApplyAppcastUrl();
+      callback_generation_ =
+          g_updater_callback_generation.fetch_add(
+              1, std::memory_order_acq_rel) +
+          1;
+      g_updater_callbacks_enabled.store(true, std::memory_order_release);
+      initialized_ = true;
+      win_sparkle_init();
+      StartPeriodicCheckTimer();
+      if (GlobalBrowserCollection* browsers =
+              GlobalBrowserCollection::GetInstance()) {
+        MaybeStartStartupCheck(browsers->GetLastActiveBrowser());
+      }
+      ScheduleStartupUiRetry();
+      return;
+    }
+
+    // Already running: keep scheduling in this controller without starting a
+    // second native scheduler.
+    win_sparkle_set_automatic_check_for_updates(0);
+    StartPeriodicCheckTimer();
+    if (GlobalBrowserCollection* browsers =
+            GlobalBrowserCollection::GetInstance()) {
+      MaybeStartStartupCheck(browsers->GetLastActiveBrowser());
+    }
+    ScheduleStartupUiRetry();
+  }
+
+  raw_ptr<Profile> profile_ = nullptr;
+  bool initialized_ = false;
+  bool started_ = false;
+  bool shutdown_started_ = false;
+  bool startup_check_started_ = false;
+  int startup_ui_retry_count_ = 0;
+  bool interactive_check_pending_ = false;
+  bool current_feed_discovery_succeeded_ = false;
+  bool prompt_visible_ = false;
+  bool prompt_destruction_scheduled_ = false;
+  std::unique_ptr<FocusUpdatePrompt> update_prompt_;
+  std::unique_ptr<views::Widget> update_prompt_widget_;
+  PrefChangeRegistrar registrar_;
+  CheckState check_state_ = CheckState::kIdle;
+  uint64_t callback_generation_ = 0;
+  base::CallbackListSubscription app_terminating_subscription_;
+  base::RepeatingTimer periodic_check_timer_;
+  base::OneShotTimer queued_interactive_check_timer_;
+  base::RepeatingTimer startup_ui_retry_timer_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::ScopedObservation<ProfileManager, ProfileManagerObserver>
+      profile_manager_observation_{this};
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      browser_collection_observation_{this};
+  base::WeakPtrFactory<WinSparkleController> weak_factory_{this};
+};
+
+void PostDiscoveredUpdateVersion(std::string version, uint64_t generation) {
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(&WinSparkleController::OnUpdateFound,
+                      base::Unretained(&WinSparkleController::GetInstance()),
+                      std::move(version), generation));
+}
+
+void PostNoUpdateAvailable(uint64_t generation) {
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(&WinSparkleController::OnNoUpdateAvailable,
+                     base::Unretained(&WinSparkleController::GetInstance()),
+                     generation));
+}
+
+void PostUpdateError(std::u16string message, uint64_t generation) {
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(&WinSparkleController::OnUpdateError,
+                      base::Unretained(&WinSparkleController::GetInstance()),
+                      std::move(message), generation));
+}
+
+class VersionUpdaterWinSparkle : public VersionUpdater {
+ public:
+  explicit VersionUpdaterWinSparkle(bool enabled) : enabled_(enabled) {
+    subscription_ = WinSparkleStatusBroadcaster::GetInstance().Subscribe(
+        base::BindRepeating(&VersionUpdaterWinSparkle::OnStatus,
+                            weak_factory_.GetWeakPtr()));
+  }
+
+  VersionUpdaterWinSparkle(const VersionUpdaterWinSparkle&) = delete;
+  VersionUpdaterWinSparkle& operator=(const VersionUpdaterWinSparkle&) = delete;
+
+  ~VersionUpdaterWinSparkle() override = default;
+
+  // VersionUpdater:
+  void CheckForUpdate(StatusCallback status_callback,
+                      PromoteCallback /*promote_callback*/) override {
+    status_callback_ = std::move(status_callback);
+
+    if (!enabled_) {
+      RunStatus(DISABLED);
+      return;
+    }
+
+    if (ApplicationIsNearlyUpdated()) {
+      RunStatus(NEARLY_UPDATED);
+      return;
+    }
+
+    RunStatus(CHECKING);
+    WinSparkleController::GetInstance().RequestInteractiveCheckFromAbout();
+  }
+
+ private:
+  void RunStatus(Status status,
+                 int progress = 0,
+                 const std::u16string& message = {}) {
+    if (status_callback_.is_null()) {
+      return;
+    }
+    status_callback_.Run(status, progress, /*rollback=*/false,
+                         /*powerwash=*/false, /*version=*/std::string(),
+                         /*update_size=*/0, message);
+  }
+
+  void OnStatus(VersionUpdater::Status status,
+                int progress,
+                const std::u16string& message) {
+    RunStatus(status, progress, message);
+  }
+
+  const bool enabled_;
+  StatusCallback status_callback_;
+  base::CallbackListSubscription subscription_;
+  base::WeakPtrFactory<VersionUpdaterWinSparkle> weak_factory_{this};
+};
+
+}  // namespace
+
+bool WinSparkleEnabled(PrefService* prefs) {
+  return UpdaterRuntimeConfigured() && prefs &&
+         focus::ShouldAccessUpdateService(*prefs);
+}
+
+void InitializeWinSparkle(Profile* profile) {
+  WinSparkleController::GetInstance().Start(profile);
+}
+
+bool ApplicationIsNearlyUpdated() {
+  return g_nearly_updated.load(std::memory_order_acquire) ||
+         HasPendingUpdateSwap();
+}
+
+bool MaybeElevateSystemUpdateOnRelaunch() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+  // Per-user installs apply with no elevation.
+  if (!install_static::IsSystemInstall()) {
+    return false;
+  }
+
+  // No verified system update waiting.
+  if (PendingSystemPayload().empty()) {
+    return false;
+  }
+
+  // The apply helper ships next to chrome.dll in the version dir.
+  base::FilePath module_dir;
+  if (!base::PathService::Get(base::DIR_MODULE, &module_dir)) {
+    return false;
+  }
+  const base::FilePath helper =
+      module_dir.Append(FILE_PATH_LITERAL("focus_update_helper.exe"));
+
+  const std::wstring params = L"--payload=\"" + PendingSystemPayload() +
+                              L"\" --signature=\"" + PendingSystemSignature() +
+                              L"\" --wait-pid=" +
+                              base::NumberToWString(::GetCurrentProcessId());
+
+  SHELLEXECUTEINFOW sei = {sizeof(sei)};
+  sei.fMask = SEE_MASK_NOASYNC;
+  sei.lpVerb = L"runas";
+  sei.lpFile = helper.value().c_str();
+  sei.lpParameters = params.c_str();
+  sei.nShow = SW_SHOWNORMAL;
+  if (!::ShellExecuteExW(&sei)) {
+    LOG(WARNING) << "WinSparkle: elevated update apply not started, err="
+                 << ::GetLastError();
+    return false;
+  }
+  return true;
+}
+
+}  // namespace focus
+
+std::unique_ptr<VersionUpdater> VersionUpdater::Create(
+    content::WebContents* web_contents) {
+  PrefService* prefs = nullptr;
+  if (web_contents) {
+    if (auto* profile =
+            Profile::FromBrowserContext(web_contents->GetBrowserContext())) {
+      prefs = profile->GetPrefs();
+    }
+  }
+  return std::make_unique<focus::VersionUpdaterWinSparkle>(
+      focus::WinSparkleEnabled(prefs));
+}
