+void LocationBarView::SetFocusYoutubeButtonVisible(bool visible) {
+  if (!focus_youtube_button_ ||
+      focus_youtube_button_->GetVisible() == visible) {
+    return;
+  }
+  if (!visible) {
+    if (views::DialogDelegate* bubble =
+            focus_youtube_button_->GetProperty(views::kAnchoredDialogKey)) {
+      if (views::Widget* widget = bubble->GetWidget()) {
+        widget->Close();
+      }
+    }
+  }
+  focus_youtube_button_->SetVisible(visible);
+  InvalidateLayout();
+}
