+void LocationBarView::RefreshFocusYoutubeButtonIcon() {
+  if (!focus_youtube_button_) {
+    return;
+  }
+
+  views::SetImageFromVectorIconWithColor(
+      focus_youtube_button_, vector_icons::kFocusYoutubeOffIcon,
+      views::IconColors(kColorOmniboxActionIcon, kColorOmniboxActionIcon,
+                        kColorOmniboxActionIconHover),
+      GetLayoutConstant(LayoutConstant::kLocationBarTrailingIconSize));
+  focus_youtube_button_->SetBorder(views::CreateEmptyBorder(
+      GetLayoutInsets(LOCATION_BAR_PAGE_ACTION_ICON_PADDING)));
+}
