--- a/chrome/app/BUILD.gn
+++ b/chrome/app/BUILD.gn
@@ -53,6 +53,9 @@ source_set("chrome_dll_resources") {
   if (is_win) {
     sources += [ "chrome_dll.rc" ]
 
+    # Keep the icon embedded in chrome.dll in sync with the Focus Browser ICO.
+    inputs = [ "//chrome/app/theme/chromium/win/chromium.ico" ]
+
     deps += [
       "//build:branding_buildflags",
       "//printing/buildflags",
