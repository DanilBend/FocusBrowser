# Python files
__pycache__/
*.py[cod]

# Python testing files
.coverage

# Ignore macOS Finder meta
.DS_Store
.tm_properties

# Ignore optional build / cache directory
/build

# Keep the canonical browser icon frames versioned so a clean checkout can
# build without relying on an unrecorded local generator run.
/resources/generated/*
!/resources/generated/product_icon/
!/resources/generated/product_icon/*.png
/devutils/i18n-data
