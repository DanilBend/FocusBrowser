+// Copyright 2025 The Focus Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/services_schema_handler.h"
+
+#include "base/functional/bind.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/focus_services/pref_names.h"
+#include "components/focus_services/schema.h"
+#include "components/prefs/pref_service.h"
+
+FocusServicesSchemaHandler::FocusServicesSchemaHandler(Profile* profile)
+    : pref_service_(profile->GetPrefs()) {}
+
+FocusServicesSchemaHandler::~FocusServicesSchemaHandler() = default;
+
+void FocusServicesSchemaHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getServicesSchemaChangelog",
+      base::BindRepeating(&FocusServicesSchemaHandler::HandleChangelogRequest,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "updateServicesSchemaVersion",
+      base::BindRepeating(
+          &FocusServicesSchemaHandler::HandleChangelogAcknowledgment,
+          base::Unretained(this)));
+}
+
+void FocusServicesSchemaHandler::HandleChangelogRequest(
+    const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  const auto& callback_id = args[0].GetString();
+  base::ListValue out;
+
+  if (focus::ShouldShowSchemaNotification(*pref_service_)) {
+    int user_version = pref_service_->GetInteger(prefs::kFocusSchemaVersion);
+    auto& changelog = focus::GetChangelog();
+
+    for (auto it = changelog.upper_bound(user_version); it != changelog.end();
+         ++it) {
+      out.Append(it->second);
+    }
+  }
+
+  AllowJavascript();
+  ResolveJavascriptCallback(base::Value(callback_id), std::move(out));
+}
+
+void FocusServicesSchemaHandler::HandleChangelogAcknowledgment(
+    const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  bool ignore_alerts = args[0].GetBool();
+
+  focus::AcceptCurrentSchema(*pref_service_);
+  pref_service_->SetBoolean(prefs::kFocusDisableSchemaAlerts, ignore_alerts);
+}
