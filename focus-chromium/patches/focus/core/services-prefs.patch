+// Copyright 2025 The Focus Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview A helper object used from the "Focus Browser services" section
+ * to request a changelog (if one exists).
+ */
+
+// clang-format off
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+// clang-format on
+
+export interface FocusServicesChangeHandler {
+  // Get the pending changes to Focus Browser services to announce
+  // to the user.
+  requestChangelog(): Promise<string[]>;
+  acknowledgeChanges(ignoreAllChangelogs: boolean): void;
+}
+
+export class FocusServicesChangeHandlerImpl implements
+    FocusServicesChangeHandler {
+  requestChangelog() {
+    return sendWithPromise<string[]>('getServicesSchemaChangelog');
+  }
+
+  acknowledgeChanges(ignoreAllChangelogs: boolean) {
+    chrome.send('updateServicesSchemaVersion', [ignoreAllChangelogs]);
+  }
+
+  static getInstance(): FocusServicesChangeHandler {
+    return instance || (instance = new FocusServicesChangeHandlerImpl());
+  }
+
+  static setInstance(obj: FocusServicesChangeHandler) {
+    instance = obj;
+  }
+}
+
+let instance: FocusServicesChangeHandler|null = null;
