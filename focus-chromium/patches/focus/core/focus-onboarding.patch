+                <span class="option-check"><IconCheck /></span>
+                <span class="option-copy">
+                    <h4>{s.focus.minimalTitle}</h4>
+                    <p>{s.focus.minimalDesc}</p>
+                </span>
+            </button>
+
+            <p id="focus-note">{s.focus.note}</p>
+        </div>
+    </div>
+</div>
+
