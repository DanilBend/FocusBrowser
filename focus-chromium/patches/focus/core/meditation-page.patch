--- /dev/null
+++ b/chrome/browser/resources/meditation/meditation.ts
@@ -0,0 +1,34 @@
+// Copyright 2026 The Focus Browser Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+const VIDEO_URL =
+    'https://www.youtube-nocookie.com/embed/R2K7ZHsnypI?rel=0';
+
+function requiredElement<T extends HTMLElement>(id: string): T {
+  const element = document.getElementById(id);
+  if (!element) {
+    throw new Error(`Missing required element: ${id}`);
+  }
+  return element as T;
+}
+
+document.addEventListener('DOMContentLoaded', () => {
+  const loadButton =
+      requiredElement<HTMLButtonElement>('load-video');
+  const privacyGate = requiredElement<HTMLElement>('privacy-gate');
+  const player =
+      requiredElement<HTMLIFrameElement>('meditation-video');
+  const status = requiredElement<HTMLElement>('connection-status');
+
+  loadButton.addEventListener('click', () => {
+    loadButton.disabled = true;
+    status.textContent = 'Устанавливается соединение с YouTube…';
+
+    player.addEventListener('load', () => {
+      status.textContent =
+          'Видео загружено с YouTube в режиме повышенной конфиденциальности.';
+    }, {once: true});
+
+    player.src = VIDEO_URL;
+    privacyGate.hidden = true;
+    player.hidden = false;
+    player.focus();
+  }, {once: true});
+});
