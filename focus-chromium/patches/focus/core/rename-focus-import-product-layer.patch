diff --git a/chrome/browser/ui/webui/settings/focus_importer_observer.cc b/chrome/browser/ui/webui/settings/focus_importer_observer.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/webui/settings/focus_importer_observer.cc
@@ -0,0 +1,85 @@
+/* Copyright (c) 2022 The Brave Authors. All rights reserved.
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "chrome/browser/ui/webui/settings/focus_importer_observer.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "chrome/browser/importer/external_process_importer_host.h"
+
+FocusImporterObserver::FocusImporterObserver(
+    ExternalProcessImporterHost* importer_host,
+    const user_data_importer::SourceProfile& source_profile,
+    uint16_t imported_items,
+    ReportProgressCallback callback)
+    : source_profile_(source_profile),
+      imported_items_(imported_items),
+      callback_(std::move(callback)),
+      importer_host_(importer_host) {
+  DCHECK(importer_host);
+  importer_host->set_observer(this);
+}
+
+FocusImporterObserver::~FocusImporterObserver() {
+  if (importer_host_)
+    importer_host_->set_observer(nullptr);
+}
+
+// user_data_importer::ImporterProgressObserver:
+void FocusImporterObserver::ImportStarted() {
+  if (import_started_called_)
+    return;
+  import_started_called_ = true;
+  base::DictValue data;
+  data.Set("importer_name", source_profile_.importer_name);
+  data.Set("importer_type", source_profile_.importer_type);
+  data.Set("items_to_import", imported_items_);
+  data.Set("event", "ImportStarted");
+  callback_.Run(source_profile_, data);
+}
+
+void FocusImporterObserver::ImportItemStarted(
+    user_data_importer::ImportItem item) {
+  base::DictValue data;
+  data.Set("importer_name", source_profile_.importer_name);
+  data.Set("importer_type", source_profile_.importer_type);
+  data.Set("items_to_import", imported_items_);
+  data.Set("event", "ImportItemStarted");
+  data.Set("item", item);
+  callback_.Run(source_profile_, data);
+}
+
+void FocusImporterObserver::ImportItemEnded(
+    user_data_importer::ImportItem item) {
+  base::DictValue data;
+  data.Set("importer_name", source_profile_.importer_name);
+  data.Set("importer_type", source_profile_.importer_type);
+  data.Set("items_to_import", imported_items_);
+  data.Set("event", "ImportItemEnded");
+  data.Set("item", item);
+  callback_.Run(source_profile_, data);
+}
+
+void FocusImporterObserver::ImportEnded() {
+  base::DictValue data;
+  data.Set("importer_name", source_profile_.importer_name);
+  data.Set("importer_type", source_profile_.importer_type);
+  data.Set("items_to_import", imported_items_);
+  data.Set("event", "ImportEnded");
+
+  DCHECK(importer_host_);
+  if (importer_host_)
+    importer_host_->set_observer(nullptr);
+
+  importer_host_ = nullptr;
+
+  callback_.Run(source_profile_, data);
+}
+
+ExternalProcessImporterHost*
+FocusImporterObserver::GetImporterHostForTesting() {
+  return importer_host_.get();
+}
