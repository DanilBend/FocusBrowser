+void OmniboxViewViews::CancelFocusTypingReveals() {
+  focus_typing_repaint_timer_.Stop();
+  if (focus_typing_reveals_.empty()) {
+    return;
+  }
+  focus_typing_reveals_.clear();
+  SchedulePaint();
+}
+
+void OmniboxViewViews::UpdateFocusTypingRevealsForEdit(
+    size_t unchanged_prefix,
+    size_t old_suffix_start,
+    size_t new_suffix_start) {
+  const int64_t suffix_shift = static_cast<int64_t>(new_suffix_start) -
+                               static_cast<int64_t>(old_suffix_start);
+  const size_t new_text_length = GetText().size();
+  std::erase_if(focus_typing_reveals_, [&](FocusTypingReveal& reveal) {
+    if (!reveal.range.IsValid()) {
+      return true;
+    }
+    if (reveal.range.end() <= unchanged_prefix) {
+      return false;
+    }
+    if (reveal.range.start() < old_suffix_start) {
+      // The edit replaced this reveal, so it no longer describes a visible
+      // grapheme in the new text.
+      return true;
+    }
+
+    const int64_t shifted_start =
+        static_cast<int64_t>(reveal.range.start()) + suffix_shift;
+    const int64_t shifted_end =
+        static_cast<int64_t>(reveal.range.end()) + suffix_shift;
+    if (shifted_start < 0 || shifted_end < shifted_start ||
+        shifted_end > static_cast<int64_t>(new_text_length)) {
+      return true;
+    }
+    reveal.range = gfx::Range(static_cast<size_t>(shifted_start),
+                              static_cast<size_t>(shifted_end));
+    return false;
+  });
+}
