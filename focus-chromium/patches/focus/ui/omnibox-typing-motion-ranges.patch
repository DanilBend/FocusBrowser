+void OmniboxViewViews::AddFocusTypingReveal(const gfx::Range& inserted_range) {
+  if (!inserted_range.IsValid() || inserted_range.is_empty()) {
+    return;
+  }
+
+  const gfx::Range grapheme_range =
+      GetRenderText()->ExpandRangeToGraphemeBoundary(inserted_range);
+  if (!grapheme_range.IsValid() || grapheme_range.is_empty() ||
+      grapheme_range.end() > GetText().size()) {
+    return;
+  }
+
+  // Replacing part of a grapheme can expand the new range over an older
+  // reveal. Remove only that overlap; all other recent glyphs keep their own
+  // timestamps and continue at their current opacity.
+  std::erase_if(focus_typing_reveals_, [&](const FocusTypingReveal& reveal) {
+    return reveal.range.IsValid() &&
+           reveal.range.start() < grapheme_range.end() &&
+           grapheme_range.start() < reveal.range.end();
+  });
+
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const std::u16string current_text = GetText();
+  const std::u16string_view inserted_text(
+      current_text.data() + grapheme_range.start(), grapheme_range.length());
+  base::i18n::BreakIterator iterator(
+      inserted_text, base::i18n::BreakIterator::BREAK_CHARACTER);
+  size_t grapheme_index = 0;
+  bool added_reveal = false;
+  if (iterator.Init()) {
+    while (iterator.Advance()) {
+      const base::TimeDelta delay =
+          std::min(kFocusTypingGraphemeStagger * grapheme_index,
+                   kFocusTypingMaximumStagger);
+      if (grapheme_index + 1 == kFocusTypingMaximumGraphemeReveals) {
+        focus_typing_reveals_.push_back(FocusTypingReveal{
+            gfx::Range(grapheme_range.start() + iterator.prev(),
+                       grapheme_range.end()),
+            now + delay, FocusTypingMotionKind::kInsertion});
+        added_reveal = true;
+        break;
+      }
+      focus_typing_reveals_.push_back(
+          FocusTypingReveal{gfx::Range(grapheme_range.start() + iterator.prev(),
+                                       grapheme_range.start() + iterator.pos()),
+                            now + delay, FocusTypingMotionKind::kInsertion});
+      added_reveal = true;
+      ++grapheme_index;
+    }
+  }
+  if (!added_reveal) {
+    focus_typing_reveals_.push_back(FocusTypingReveal{
+        grapheme_range, now, FocusTypingMotionKind::kInsertion});
+  }
+
+  if (!focus_typing_repaint_timer_.IsRunning()) {
+    focus_typing_repaint_timer_.Start(
+        FROM_HERE, kFocusTypingRepaintInterval, this,
+        &OmniboxViewViews::AdvanceFocusTypingReveals);
+  }
+  SchedulePaint();
+}
+
+void OmniboxViewViews::AddFocusDeletionSettle(size_t deletion_boundary) {
+  if (GetText().empty()) {
+    return;
+  }
+
+  const size_t text_length = GetText().size();
+  const gfx::Range probe =
+      deletion_boundary < text_length
+          ? gfx::Range(deletion_boundary, deletion_boundary + 1)
+          : gfx::Range(text_length - 1, text_length);
+  const gfx::Range grapheme_range =
+      GetRenderText()->ExpandRangeToGraphemeBoundary(probe);
+  if (!grapheme_range.IsValid() || grapheme_range.is_empty() ||
+      grapheme_range.end() > text_length) {
+    return;
+  }
+
+  std::erase_if(focus_typing_reveals_, [&](const FocusTypingReveal& reveal) {
+    return reveal.range.IsValid() &&
+           reveal.range.start() < grapheme_range.end() &&
+           grapheme_range.start() < reveal.range.end();
+  });
+  focus_typing_reveals_.push_back(
+      FocusTypingReveal{grapheme_range, base::TimeTicks::Now(),
+                        FocusTypingMotionKind::kDeletionSettle});
+
+  if (!focus_typing_repaint_timer_.IsRunning()) {
+    focus_typing_repaint_timer_.Start(
+        FROM_HERE, kFocusTypingRepaintInterval, this,
+        &OmniboxViewViews::AdvanceFocusTypingReveals);
+  }
+  SchedulePaint();
+}
+
+void OmniboxViewViews::AdvanceFocusTypingReveals() {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  std::erase_if(focus_typing_reveals_, [&](const FocusTypingReveal& reveal) {
+    return now - reveal.started_at >= kFocusTypingRevealDuration;
+  });
+  if (focus_typing_reveals_.empty()) {
+    focus_typing_repaint_timer_.Stop();
+  }
+  SchedulePaint();
+}
