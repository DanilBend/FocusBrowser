-void Textfield::UpdateCursorViewPosition() {
-  cursor_view_->SetBoundsRect(CalculateCursorViewBounds());
+void Textfield::UpdateCursorViewPosition(bool animate) {
+  const gfx::Rect target_bounds = CalculateCursorViewBounds();
+  const bool should_animate =
+      animate && ShouldAnimateCaretMotion() && HasFocus() &&
+      GetTextInputType() != ui::TEXT_INPUT_TYPE_PASSWORD &&
+      !cursor_view_->bounds().IsEmpty() && !target_bounds.IsEmpty() &&
+      cursor_view_->bounds() != target_bounds;
+  if (should_animate) {
+    ui::ScopedLayerAnimationSettings settings(
+        cursor_view_->layer()->GetAnimator());
+    settings.SetTransitionDuration(base::Milliseconds(90));
+    settings.SetTweenType(gfx::Tween::ACCEL_0_80_DECEL_80);
+    settings.SetPreemptionStrategy(
+        ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET);
+    cursor_view_->SetBoundsRect(target_bounds);
+  } else {
+    cursor_view_->SetBoundsRect(target_bounds);
+  }
   GetViewAccessibility().SetScrollX(
       GetRenderText()->GetUpdatedDisplayOffset().x());
 }
 
+bool Textfield::ShouldAnimateCaretMotion() const {
+  return false;
+}
