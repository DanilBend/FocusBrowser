+bool LocationBarView::ShouldAnimateFocusMotion() const {
+  return profile_ &&
+         profile_->GetPrefs()->GetBoolean(prefs::kFocusMotionEnabled) &&
+         gfx::Animation::ShouldRenderRichAnimation() &&
+         !gfx::Animation::PrefersReducedMotion() &&
+         GetNativeTheme()->preferred_contrast() !=
+             ui::NativeTheme::PreferredContrast::kMore;
+}
+
+void LocationBarView::OnFocusMotionPreferenceChanged() {
+  if (omnibox_view_) {
+    omnibox_view_->CancelFocusTypingReveals();
+  }
+  const bool should_show_hover =
+      IsMouseHovered() && omnibox_view_ && !omnibox_view_->HasFocus();
+  hover_animation_.Reset(should_show_hover ? 1.0 : 0.0);
+  RefreshBackground();
+}
+
 void LocationBarView::OnOmniboxHovered(bool is_hovering) {
-  if (is_hovering) {
-    // Only show the hover animation when omnibox is in unfocused steady state.
-    if (!omnibox_view_->HasFocus()) {
-      hover_animation_.Show();
-    }
+  const bool should_show_hover = is_hovering && !omnibox_view_->HasFocus();
+  if (!ShouldAnimateFocusMotion()) {
+    // Keep hover feedback when animations are disabled, but snap directly to
+    // its final state instead of running a transition.
+    hover_animation_.Reset(should_show_hover ? 1.0 : 0.0);
+    RefreshBackground();
+    return;
+  }
+
+  if (should_show_hover) {
+    hover_animation_.Show();
   } else {
     hover_animation_.Hide();
   }
