+void LocationBarView::OnOmniboxInputEdited() {
+  typing_animation_.Reset();
+  if (!is_initialized_ || is_popup_mode_ || !ShouldAnimateFocusMotion()) {
+    RefreshBackground();
+    return;
+  }
+
+  typing_animation_.Show();
+}
+
+bool LocationBarView::IsOmniboxTypingAnimationRunning() const {
+  return typing_animation_.is_animating();
+}
+
+double LocationBarView::GetOmniboxTypingAnimationValue() const {
+  return typing_animation_.GetCurrentValue();
+}
+
+bool LocationBarView::ShouldAnimateFocusMotion() const {
+  return profile_ &&
+         profile_->GetPrefs()->GetBoolean(prefs::kFocusMotionEnabled) &&
+         gfx::Animation::ShouldRenderRichAnimation() &&
+         !gfx::Animation::PrefersReducedMotion() &&
+         GetNativeTheme()->preferred_contrast() !=
+             ui::NativeTheme::PreferredContrast::kMore;
+}
+
+void LocationBarView::OnFocusMotionPreferenceChanged() {
+  typing_animation_.Reset();
+  const bool should_show_hover =
+      IsMouseHovered() && omnibox_view_ && !omnibox_view_->HasFocus();
+  hover_animation_.Reset(should_show_hover ? 1.0 : 0.0);
+  RefreshBackground();
+}
